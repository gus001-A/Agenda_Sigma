# Configuración de producción para el hosting compartido.
# empaquetar.sh la copia como laravel/.env en la primera instalación y llena APP_KEY.

APP_NAME="SIGMA24 Agenda"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ric.sistema-sicad.site/agenda

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# SQLite: laravel/database/database.sqlite (fuera del alcance web)
DB_CONNECTION=sqlite

# El subdominio lo comparten otros sistemas: cookie propia y limitada a /agenda
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=sigma24_agenda_session
SESSION_PATH=/agenda
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
CACHE_PREFIX=sigma24_agenda_

# En hosting compartido no hay un worker de colas corriendo
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Correo saliente (datos de la cuenta de correo del hosting)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.sistema-sicad.site
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@sistema-sicad.site"
MAIL_FROM_NAME="${APP_NAME}"

# Botones de entrada rápida con los usuarios de demostración (contraseña demo1234).
# Déjalo en false si el sistema tendrá datos reales.
ACCESOS_DEMO=false

# Contraseña del administrador gustavo@sigma.com (vacío = se genera una al azar)
ADMIN_PASSWORD=

# Base heredada de SIGMA para importar pacientes (php artisan sigma:importar-pacientes)
SIGMA_DB_HOST=localhost
SIGMA_DB_DATABASE=sigma2024
SIGMA_DB_USERNAME=
SIGMA_DB_PASSWORD=

# Mensajería al paciente: log (simulado), mail (correo) o twilio (SMS reales)
MENSAJERIA_SMS=log
# Cambia a mail cuando el correo SMTP de arriba esté configurado
MENSAJERIA_CORREO=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_LADA=+52
